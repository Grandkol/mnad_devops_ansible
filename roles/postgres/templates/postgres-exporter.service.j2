{{ ansible_managed | comment }}
[Unit]
Description=Postgres Prometheus exporter
Documentation=https://github.com/prometheus-community/postgres_exporter
Wants=postgres.service
After=postgres.service

[Service]
Type=simple
DynamicUser=true
EnvironmentFile=/etc/default/postgres-exporter
ExecStart=/usr/local/sbin/postgres-exporter \
  --web.listen-address=:{{ postgres__exporter_port }}
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
